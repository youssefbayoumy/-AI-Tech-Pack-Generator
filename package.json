{
  "name": "ai-tech-pack-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "next dev",
    "diagnostic:build": "tsc -p tsconfig.diagnostic.json",
    "diagnostic:gemini-isolation": "node --loader ./scripts/server-only-loader.mjs ./.diagnostic-build/scripts/gemini-isolation-diagnostic.js",
    "diagnostic:golden": "npm run diagnostic:build && node --loader ./scripts/server-only-loader.mjs ./.diagnostic-build/scripts/tech-pack-generation-diagnostic.js",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "next": "^16.3.4",
    "openai": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "10.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
