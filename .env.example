# Required only when making a live generation request. Never prefix either with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Select exactly one server-side inference provider: openai, openrouter, or gemini.
# Gemini is the production configuration for this challenge.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-32b-instruct:free
OPENROUTER_MAX_OUTPUT_TOKENS=32000
OPENROUTER_TIMEOUT_MS=180000

# Required only when AI_PROVIDER=gemini and a generation is invoked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_MAX_OUTPUT_TOKENS=32000
GEMINI_TIMEOUT_MS=180000
